# ── Required. Boot fails, naming this variable, if it is unset. ───────────────
GROQ_API_KEY=your_groq_key_here

# ── LLM ───────────────────────────────────────────────────────────────────────
ROUTER_MODEL=llama-3.3-70b-versatile
DRAFTER_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Golden runs are fixed at 0.2; see backend/tests/golden/README.md.
LLM_TEMPERATURE=0.2
MAX_CRITIC_RETRIES=2
MAX_HEALER_RETRIES=2

# ── Storage ───────────────────────────────────────────────────────────────────
S3_BUCKET=
AWS_REGION=ap-south-1
KMS_KEY_ID=
PRESIGN_TTL_SECONDS=900
OUTPUT_DIR=output

# ── Infrastructure — matches docker-compose.yml (S2, S4) ──────────────────────
DATABASE_URL=postgresql+asyncpg://realestate:realestate@localhost:5433/realestate
REDIS_URL=redis://localhost:6380/0

# ── Valuation policy — enforced from S6/S7 ────────────────────────────────────
ROUNDING_POLICY=half_up
MONEY_DP=2
DEFAULT_AREA_UNIT=sqft
COMPARABLE_RADIUS_M=2000
COMPARABLE_MIN_SAMPLE=3
COMPARABLE_MAX_AGE_MONTHS=18

# ── HTTP ──────────────────────────────────────────────────────────────────────
PORT=8004
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
WEBHOOK_URL=
SENTRY_DSN=
LOG_LEVEL=INFO
