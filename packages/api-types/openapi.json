{
  "components": {
    "schemas": {
      "GenerateRequest": {
        "properties": {
          "basis": {
            "anyOf": [
              {
                "enum": [
                  "market",
                  "fair",
                  "liquidation",
                  "distress",
                  "insurable"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Basis"
          },
          "instructions": {
            "maxLength": 20000,
            "minLength": 1,
            "title": "Instructions",
            "type": "string"
          },
          "job_type": {
            "anyOf": [
              {
                "enum": [
                  "construction_disbursement_report",
                  "development_agreement",
                  "due_diligence_report",
                  "environment_impact_assessment",
                  "fema_compliance",
                  "lease_agreement",
                  "mou",
                  "noc_application",
                  "portfolio_report",
                  "power_of_attorney",
                  "rent_roll_report",
                  "rental_agreement",
                  "rera_quarterly_report",
                  "rera_registration",
                  "sale_deed",
                  "valuation_report"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Job Type"
          },
          "premise": {
            "anyOf": [
              {
                "enum": [
                  "existing_use",
                  "highest_best_use"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Premise"
          },
          "property_data": {
            "default": "",
            "maxLength": 2000000,
            "title": "Property Data",
            "type": "string"
          },
          "purpose": {
            "anyOf": [
              {
                "enum": [
                  "loan",
                  "ibc",
                  "dispute",
                  "financial_reporting",
                  "internal"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Purpose"
          }
        },
        "required": [
          "instructions"
        ],
        "title": "GenerateRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JobStatus": {
        "properties": {
          "doc_url": {
            "default": "",
            "title": "Doc Url",
            "type": "string"
          },
          "error": {
            "default": "",
            "title": "Error",
            "type": "string"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "job_type": {
            "default": "",
            "title": "Job Type",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "terminal_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Terminal At"
          }
        },
        "required": [
          "job_id",
          "status"
        ],
        "title": "JobStatus",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
